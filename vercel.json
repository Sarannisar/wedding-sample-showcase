{
  "rewrites": [
    {
      "source": "/invite/(.+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Applebot|Discordbot).*"
        }
      ],
      "destination": "/api/invite-preview?slug=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
